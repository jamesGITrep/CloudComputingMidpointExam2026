# Database Configuration
USER_DB_USER=postgres
USER_DB_PASSWORD=your_user_db_password
USER_DB_NAME=user_auth_db
USER_DB_HOST=user-db

TICKET_DB_USER=ticket_user
TICKET_DB_PASSWORD=your_ticket_db_password
TICKET_DB_NAME=ticket_db
TICKET_DB_ROOT_PASSWORD=your_root_password
TICKET_DB_HOST=ticket-db

KB_DB_USER=postgres
KB_DB_PASSWORD=your_kb_db_password
KB_DB_NAME=kb_db
KB_DB_HOST=kb-db

AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=your_audit_db_password
AUDIT_DB_NAME=audit_db
AUDIT_DB_ROOT_PASSWORD=your_root_password
